#!/usr/bin/env bash
# Post a tag receipt to the current branch's PR (GitHub's comment time is a third-party clock).
# usage: .agents/tools/prereg-receipt <tag>
set -euo pipefail
tag="$1"
commit=$(git rev-parse "$tag^{commit}")
# Hash each file AS COMMITTED AT THE TAG, not the working tree, so a receipt posted late still describes what was tagged.
hash() { if [ -n "$eid" ] && git cat-file -e "$commit:$1" 2>/dev/null; then git show "$commit:$1" | shasum -a 256 | cut -c1-64; else echo "n/a"; fi; }
tagdate=$(git for-each-ref --format='%(taggerdate:iso-strict)' "refs/tags/$tag")
# The EID is the tag minus its milestone suffix. EIDs contain hyphens (E01-stentor-map), so cutting at the first
# hyphen hashed experiments/E01/... and posted n/a. A tag with no milestone suffix (model-v0.1.0) has no EID.
case "$tag" in
  *-prereg) eid="${tag%-prereg}" ;;
  *-run) eid="${tag%-run}" ;;
  *-closed) eid="${tag%-closed}" ;;
  *-interim-[0-9]*) eid="${tag%-interim-*}" ;;
  *) eid="" ;;
esac
body=$(cat <<MSG
<!-- prereg-receipt v1 tag=$tag commit=$commit -->
**Tag receipt** \`$tag\`
- commit: \`$commit\`
- tagged: $tagdate
- experiment: ${eid:-none (not an experiment milestone tag)}
- PREREG.md sha256 at the tag: \`$(hash "experiments/$eid/PREREG.md")\`
- ENV.lock sha256 at the tag: \`$(hash "experiments/$eid/ENV.lock")\`
MSG
)
# gh often lives outside the PATH hooks and agents get; look in the usual install locations too.
gh=$(command -v gh 2>/dev/null || true)
for c in "$HOME/.local/bin/gh" /opt/homebrew/bin/gh /usr/local/bin/gh /home/linuxbrew/.linuxbrew/bin/gh; do
  [ -n "$gh" ] && break; [ -x "$c" ] && gh="$c"
done
[ -n "$gh" ] || { echo "prereg-receipt: gh not found (PATH or the usual install locations); receipt not posted" >&2; exit 0; }
"$gh" pr comment --body "$body" 2>/dev/null || echo "prereg-receipt: no PR yet; re-run after gh pr create" >&2
